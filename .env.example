# Public scanner works without these OAuth values.
# Add these only when you deploy the app and register a Deriv OAuth2 client.

DERIV_OAUTH_CLIENT_ID=your_deriv_oauth_client_id
APP_BASE_URL=https://your-public-domain.example
DERIV_OAUTH_SCOPE=trade
SESSION_SECRET=replace_with_a_long_random_secret
PORT=3000
