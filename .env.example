# MatchPredict AI V25.2
PORT=3000
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
SESSION_SECRET=replace_with_a_long_random_secret

# Deriv OAuth
DERIV_OAUTH_CLIENT_ID=
DERIV_OAUTH_SCOPE=trade

# Access control
# Set this to YOUR Deriv account ID only. This account bypasses trial/payment.
OWNER_DERIV_ACCOUNT_ID=
TRIAL_ENFORCEMENT=false
PAYMENTS_ENABLED=false

# Persistent database (required before public paid launch)
DATABASE_URL=

# Flutterwave
FLW_SECRET_KEY=

# Pesapal
PESAPAL_ENV=live
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_NOTIFICATION_ID=

# Binance Pay
BINANCE_PAY_API_KEY=
BINANCE_PAY_SECRET_KEY=
# Override only if Binance merchant docs for your account use another create-order path
BINANCE_PAY_CREATE_PATH=/binancepay/openapi/v3/order
